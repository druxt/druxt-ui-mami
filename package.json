{
  "name": "druxt-umami-ui",
  "version": "0.1.0",
  "description": "The Umami demo's look for a Nuxt 2 site: its theme and presentational Vue components, on Bootstrap 4.",
  "license": "MIT",
  "main": "module.js",
  "files": [
    "components",
    "dist",
    "module.js"
  ],
  "scripts": {
    "build": "sass --silence-deprecation=global-builtin --no-source-map --style=compressed src/scss/theme.scss dist/umami.css",
    "prepare": "npm run build"
  },
  "keywords": [
    "druxt",
    "drupal",
    "nuxt",
    "umami",
    "theme"
  ],
  "dependencies": {
    "bootstrap": "^4.6.2",
    "bootstrap-vue": "^2.23.1"
  },
  "peerDependencies": {
    "nuxt": "^2.15.0"
  },
  "devDependencies": {
    "sass": "~1.99.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/druxt/druxt-umami-ui.git"
  },
  "homepage": "https://github.com/druxt/druxt-umami-ui#readme",
  "bugs": {
    "url": "https://github.com/druxt/druxt-umami-ui/issues"
  }
}
