{
  "name": "druxt-ui-mami",
  "version": "0.1.0",
  "description": "The Umami demo's look for a Nuxt 2 site: its theme and presentational Vue components, on Bootstrap 4.",
  "license": "MIT",
  "main": "module.js",
  "files": [
    "components",
    "dist",
    "module.js"
  ],
  "scripts": {
    "build": "sass --silence-deprecation=global-builtin --no-source-map --style=compressed src/scss/theme.scss dist/umami.css",
    "changeset": "changeset",
    "hooks:install": "git config core.hooksPath .githooks",
    "lint": "npm run lint:js && npm run lint:format && npm run lint:md && npm run lint:cspell && npm run lint:private && npm run lint:attribution && npm run lint:knip",
    "lint:attribution": "bash .gitlab/scripts/check-attribution.sh",
    "lint:audit": "node scripts/audit-shipped.mjs",
    "lint:commit": "commitlint",
    "lint:cspell": "cspell lint --no-progress --no-must-find-files --gitignore --dot \"**/*.{js,mjs,vue,json,jsonc,md,yml,yaml,scss}\"",
    "lint:format": "prettier --check \"**/*.{js,mjs,vue,json,jsonc,md,yml,yaml,scss}\"",
    "lint:format:fix": "prettier --write \"**/*.{js,mjs,vue,json,jsonc,md,yml,yaml,scss}\"",
    "lint:js": "eslint .",
    "lint:knip": "knip --include dependencies,unlisted --no-config-hints",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:private": "node scripts/lint-private-refs.mjs",
    "lint:prose": "PROSE_LINT_GLOB='!{.changeset/**,CHANGELOG.md}' bash .gitlab/scripts/lint-prose.sh --all",
    "lint:prose:install": "bash .gitlab/scripts/install-vale.sh .vale/bin .vale/styles",
    "prepare": "npm run build && node scripts/prepare.mjs",
    "size": "size-limit",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "druxt",
    "drupal",
    "nuxt",
    "umami",
    "theme"
  ],
  "dependencies": {
    "bootstrap": "^4.6.2",
    "bootstrap-vue": "^2.23.1"
  },
  "peerDependencies": {
    "nuxt": "^2.15.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@babel/preset-env": "7.29.14",
    "@changesets/cli": "2.31.1",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "9.39.5",
    "@size-limit/file": "14.3.0",
    "@vue/test-utils": "1.3.6",
    "@vue/vue2-jest": "29.2.6",
    "babel-jest": "29.7.0",
    "cspell": "10.5.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "9.33.0",
    "globals": "17.14.0",
    "jest": "29.7.0",
    "jest-axe": "11.0.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-junit": "17.0.0",
    "knip": "6.45.1",
    "markdownlint-cli2": "0.24.1",
    "prettier": "3.10.1",
    "sass": "1.108.2",
    "size-limit": "14.3.0",
    "vue": "2.7.16",
    "vue-template-compiler": "2.7.16"
  },
  "packageManager": "npm@10.9.10",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/druxt/druxt-ui-mami.git"
  },
  "homepage": "https://github.com/druxt/druxt-ui-mami#readme",
  "bugs": {
    "url": "https://github.com/druxt/druxt-ui-mami/issues"
  },
  "jest-junit": {
    "outputDirectory": "reports/junit",
    "outputName": "junit.xml"
  }
}
